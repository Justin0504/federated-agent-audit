# Generated AgentLeak traces contain raw LLM messages (with vault content) — never commit
*_traces*.jsonl
agentleak_traces*.jsonl

# A2A-MT generated suite artifact (LLM content) — regenerable
a2a_mt_suite*.jsonl

# LaTeX build artifacts
paper/submission/*.pdf
paper/submission/*.aux
paper/submission/*.log
paper/submission/*.out
paper/submission/*.bbl
paper/submission/*.blg
paper/submission/*.synctex.gz
paper/submission/*.zip
paper/submission/main_anon.*

# paper build artifacts (generated)
paper/**/main.pdf
paper/**/*.aux
paper/**/*.bbl
paper/**/*.blg
paper/**/*.out
paper/**/*.xdv
paper/**/*.log
paper/**/comment.cut
paper/**/arxiv_submission.zip

# local multi-model run outputs (regenerable; numbers recorded in RESULTS.md)
mm_results/

# Trace files are gitignored by pattern, but the published traces under
# benchmarks/a2a_mt/traces/ are an ARTIFACT the paper points readers at -- they
# were lost from /tmp once already. Keep them.
!benchmarks/a2a_mt/traces/
!benchmarks/a2a_mt/traces/**

# figure preview harness output
paper/figures/_prev*
paper/figures/_contact_sheet.svg
paper/figures/icons/_contact_sheet.svg
paper/figures/export/
